---
import Footer from "../components/Footer.vue";
import NavbarDesktop from "../components/NavbarDesktop.vue";
import NavbarMobile from "../components/NavbarMobile.vue";
import "../styles/global.css"; // imports tailwind to all pages using this layout

const {
  title = "Ergotherapie Mensch/ich – Menschliche Ergotherapie Praxis in Berlin",
  description = "Ergotherapie Praxis in Berlin – individuelle und menschliche Betreuung.",
  ogDescription = "Individuelle Ergotherapie für Kinder und Erwachsene in Berlin.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <!-- <meta property="og:image" content="" /> -->

    <title>{title}</title>
  </head>
  <body id="page-top">
    <header
      class="w-full flex items-center justify-center bg-neutral-100 fixed z-20"
    >
      <NavbarDesktop
        class="sm:flex hidden items-center gap-5 md:gap-10 nav-height-desktop"
      />
      <NavbarMobile
        class="sm:hidden flex justify-between w-full items-center gap-10 nav-height-mobile"
      />
    </header>
    <main class="flex flex-col gap-22 nav-margin m-auto mb-16">
      <slot />
    </main>
    <Footer />
  </body>

  <style>
    * {
      box-sizing: border-box;
    }
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      font-family: "Carlito", Tahoma, Geneva, Verdana, sans-serif;
      background-color: var(--color-neutral-100);
      overflow-x: clip;
    }

    .nav-margin {
      padding-top: 131px;

      @media (max-width: 639px) {
        padding-top: 96px;
      }
    }

    .nav-height-desktop {
      height: var(--navbar-height-desktop);
    }

    .nav-height-mobile {
      height: var(--navbar-height-mobile);
    }
  </style>
</html>
