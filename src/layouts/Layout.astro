---
import NavbarDesktop from "../components/NavbarDesktop.vue";
import NavbarMobile from "../components/NavbarMobile.vue";
import "../styles/global.css"; // imports tailwind to all pages using this layout
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Ergotheraphie Menschlich</title>
  </head>
  <body>
    <header
      class="w-full flex items-center justify-center bg-neutral-100 fixed"
    >
      <NavbarDesktop class="sm:flex hidden" />
      <NavbarMobile class="sm:hidden" />
    </header>
    <main class="flex flex-col gap-10 nav-margin">
      <slot />
    </main>
    <footer class="w-full flex p-3 items-center justify-center bg-amber-100">
    </footer>
  </body>

  <style>
    * {
      box-sizing: border-box;
    }
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      font-family: "Carlito", Tahoma, Geneva, Verdana, sans-serif;
    }

    .nav-margin {
      padding-top: 131px;

      @media (max-width: 639px) {
        padding-top: 96px;
      }
    }
  </style>
</html>
