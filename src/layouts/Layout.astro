---
import Navbar from "../components/Navbar.vue";
import "../styles/global.css"; // imports tailwind to all pages using this layout
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Ergotheraphie Menschlich</title>
  </head>
  <body>
    <header class="w-full flex p-3 items-center justify-center bg-neutral-100">
      <Navbar />
    </header>
    <main class="flex flex-col gap-10">
      <slot />
    </main>
    <footer class="w-full flex p-3 items-center justify-center bg-amber-100">
    </footer>
  </body>

  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      font-family: "Carlito", Tahoma, Geneva, Verdana, sans-serif;
    }
  </style>
</html>
