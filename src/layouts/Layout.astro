---
import Footer from "../components/Footer.vue";
import NavbarDesktop from "../components/NavbarDesktop.astro";
import NavbarMobile from "../components/NavbarMobile.vue";
import "../styles/global.css"; // imports tailwind to all pages using this layout
import { getLangFromUrl } from "../i18n/languageUtils";

const lang = getLangFromUrl(Astro.url);

const {
  title = "Ergotherapie Mensch/ich – Ihre Praxis in Adlershof",
  description = "Ihre Ergotherapie Praxis in Berlin-Adlershof: Menschliche, individuelle Behandlungen für Kinder und Erwachsene.",
  ogDescription = "Individuelle Ergotherapie für Kinder und Erwachsene in Berlin-Adlershof",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <!-- <meta property="og:image" content="" /> -->

    <title>{title}</title>
  </head>
  <body id="page-top">
    <header
      class="w-full flex items-center justify-center bg-neutral-100 fixed z-20"
    >
      <NavbarDesktop />
      <NavbarMobile lang={lang} client:media="(max-width: 639px)" />
    </header>
    <main class="flex flex-col gap-24 nav-margin m-auto mb-16">
      <slot />
    </main>
    <Footer />
  </body>

  <style>
    * {
      box-sizing: border-box;
    }
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      font-family: "Carlito", Tahoma, Geneva, Verdana, sans-serif;
      background-color: var(--color-neutral-100);
      overflow-x: clip;
    }

    .nav-margin {
      padding-top: var(--navbar-height-desktop);

      @media (max-width: 639px) {
        padding-top: 96px;
      }
    }
  </style>
</html>
