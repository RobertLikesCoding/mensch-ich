---
import LogoSVG from "../assets/logo_menschlich.svg";
import Button from "./UI/Button.vue";

import {
  useTranslations,
  getLangFromUrl,
  buildLocalePath,
} from "../i18n/languageUtils";
import LanguageSwitcher from "./LanguageSwitcher.vue";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<nav
  class="sm:flex hidden items-center gap-5 md:gap-10 px-3 h-(--navbar-height-desktop)"
>
  <a href={buildLocalePath(lang, "#page-top")} class="flex-1">
    <LogoSVG aria-label={t("nav.logo_alt")} width={260} height={115} />
  </a>
  <ul
    class="flex gap-5 md:gap-10 items-center justify-evenly flex-2 whitespace-nowrap"
  >
    <li class="hover:underline underline-offset-5">
      <a href={buildLocalePath(lang, "#leistungen")}>{t("nav.services")}</a>
    </li>
    <li class="hover:underline underline-offset-5">
      <a href={buildLocalePath(lang, "#überuns")}>{t("nav.about_us")}</a>
    </li>
    <li class="hover:underline underline-offset-5">
      <a href={buildLocalePath(lang, "#team")}>{t("nav.team")}</a>
    </li>
    <li class="flex items-center">
      <LanguageSwitcher lang={lang} />
    </li>
    <li>
      <Button
        label={t("nav.button.contact")}
        to={buildLocalePath(lang, "#kontakt")}
        style="height: 30px"
      />
    </li>
  </ul>
</nav>
