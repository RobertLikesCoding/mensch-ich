---
interface Props {
  content: {
    title: string;
    illustration: string;
    alt: string;
    description: string;
  };
}

const { content } = Astro.props as Props;
---

<div
  class="px-3 py-5 bg-linear-to-br from-[#5D7E65] via-[#5D7E65] to-[#4A6A52] rounded-2xl text-neutral-100 flex flex-col justify-evenly items-center text-center w-78 shrink-0 shadow-xl gap-8"
  style="height: 26rem"
>
  <img src={content.illustration} alt={content.alt} class="flex-1" />

  <div class="flex flex-col gap-3 flex-2 shrink">
    <h3 class="text-2xl text-shadow-lg">{content.title}</h3>
    <p>{content.description}</p>
  </div>
</div>

<style>
  img {
    height: 130px;
  }
</style>
