---
interface TeamCardProps {
  memberInfo: {
    name: string;
    titel: string;
    skills: string[];
    description: string;
    imgPath: string;
  };
}

const { memberInfo } = Astro.props as TeamCardProps;
---

<div
  class="flex flex-col w-full sm:w-100 rounded-2xl bg-neutral-100 shadow-lg max-w-100"
>
  <div class="flex flex-col gap-3 p-3 py-5">
    <div>
      <h3 class="text-3xl font-bold text-primary-600">
        {memberInfo.name}
      </h3>
      <h4 class="text-2xl">{memberInfo.titel}</h4>
    </div>
    <p class="text-neutral-900">{memberInfo.description}</p>
  </div>
</div>
